# Copy to .env at the repository root (the code/ folder). Never commit .env.

# Render web service: internal DATABASE_URL from the linked database.
# Laptop ingest and OCR: external connection string from the Render Postgres dashboard.
DATABASE_URL=postgresql://user:password@host:5432/landis

# Same key for OCR, embeddings, and chat. Use a paid workspace before a full corpus run.
MISTRAL_API_KEY=

# Optional overrides (defaults are in config/settings.yaml)
# KNOWLEDGE_BASE=/absolute/path/to/knowledge-base
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_EMBED_MODEL=mistral-embed
# MISTRAL_CHAT_MODEL=mistral-small-latest
# EMBEDDING_DIMENSION=1024
# RAG_TOP_K=8
# LOG_CONVERSATIONS=true
# CONVERSATION_RETENTION_DAYS=365
# CHAT_HISTORY_ENABLED=true

# Extra browser origins, comma-separated, only if a page calls the API
# without an iframe on this same host.
# CORS_ALLOWED_ORIGINS=

# Optional gate for a shared Render URL. Leave both unset for local use.
# The browser will prompt for them. /health stays open for Render.
# LANDIS_BASIC_USER=
# LANDIS_BASIC_PASSWORD=
